<routes>
    <!-- First intersection -->
    <route id="route_ns" edges="n_t t_s"/>
    <flow id="flow_ns" route="route_ns" begin="0" end="100000" probability="0.2" departSpeed="max" departPos="base" departLane="best"/>

    <!-- Connection between both intersections -->
    <vType id="ambulance" accel="3.0" decel="6.0" sigma="0" length="5" maxSpeed="30" color="0,0,255"/>
    <route id="route_we" edges="w_t t_e e_t2 t2_e2"/>
    <flow id="flow_we" route="route_we" begin="0" end="100000" probability="0.5" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="ambulance_flow_we" type="ambulance" route="route_we" begin="0" end="100000" probability="0.01" departSpeed="max" departPos="base" departLane="best"/>

    <!-- Second intersection -->
    <route id="route_ns2" edges="n2_t2 t2_s2"/>
    <flow id="flow_ns2" route="route_ns2" begin="0" end="100000" probability="0.2" departSpeed="max" departPos="base" departLane="best"/>

</routes>
